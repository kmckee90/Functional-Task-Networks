# ---------------------------------------------------------------------------
# Functional Task Networks — ignore all produced artifacts.
# Every subproject writes into organized output folders; none are committed.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/

# Organized output folders (produced by experiments — never committed)
output/
checkpoints/
checkpoints_*/
results/
figures/
images/
# Experiment configurations are source, not generated artifacts.
gifs/
data_cache/
expert_data/
logs/
runs/
wandb/
artifacts/

# Datasets (downloaded/regenerable)
data/MNIST/
data/openml/

# Heavy / binary artifacts
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.gif
*.mp4

# Logs
*.log
nohup.out
*.out

# LaTeX build cruft (keep .tex, .bib, .bbl, .sty, .bst, .cls)
*.aux
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lof
*.lot

# Editor / OS
.DS_Store
.vscode/
.idea/
.claude/

*.png
*.gif
*.csv
*.pdf

*artifacts*/

metrics*.json
metrics*.jsonl
metrics*.csv

outputs/

# Independent upstream checkouts and the separately published website.
# Our extracted experiment source lives under experiments/.
/SiT/
/ViZDoom/
/experiments/sit/sit/
/experiments/doom/vizdoom/
/clrs/
/experiments/clrs/clrs/
/nlp/nanoGPT/
/experiments/nlp/nanoGPT/
/proposal_githubio/
/nascent/proposal_githubio/
# E2E remains an explicitly deferred integration; see docs/refactoring/README.md.
/e2e/
/experiments/e2e/

